# The frontend needs no environment variables at all — it talks to the
# self-hosted API at a relative /api/ path (see vite.config.ts's dev proxy
# and nginx's `location /api/` in production).
#
# Everything below is for api-server/, and lives only in
# /var/www/nse-tracker/api/.env on the server — never in this repo.
# Copy this file there as `.env` and fill in real values.

# Required.
DATABASE_URL=postgres://user:password@127.0.0.1:5432/nse_db
PORT=3015

# Used to build links inside emails (confirm/unsubscribe/welcome) and the
# subscription-status redirect target.
SITE_URL=https://nse-tracker.dukaribu.com

# Required for the newsletter to actually send email.
RESEND_API_KEY=re_your_resend_api_key
# Optional, once a custom domain is verified in the Resend dashboard —
# otherwise emails send from Resend's shared onboarding@resend.dev sandbox sender.
RESEND_FROM_EMAIL=NSE Market Intelligence <updates@yourdomain.com>
# Optional — if set, this address gets a one-line email whenever someone
# confirms a subscription.
OWNER_NOTIFICATION_EMAIL=you@yourdomain.com
