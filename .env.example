# Copy this file to .env for local development (vite dev) and fill in real values.
# .env is gitignored — never commit it.

# Public — safe to expose in the built frontend bundle. The anon key can only
# perform the reads allowed by the Row Level Security policies in
# supabase/migrations/001_initial_schema.sql (SELECT only, no writes).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Edge Functions only (supabase/functions/*) ---
# Set these as Supabase Edge Function secrets (`supabase secrets set ...`),
# never in this repo and never in the frontend bundle. The service role key
# bypasses Row Level Security entirely and must stay server-side.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Newsletter Edge Functions only (subscribe/confirm/unsubscribe/send) ---
# RESEND_API_KEY=re_your_resend_api_key
# NEWSLETTER_ADMIN_SECRET=some-long-random-string-only-you-know
# RESEND_FROM_EMAIL=NSE Market Intelligence <updates@yourdomain.com>  # optional
